{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agento:audit-report",
  "title": "agento audit report",
  "description": "Output of `agento audit --json`. Money is USD at Anthropic API list prices (API-equivalent for subscribers). Fields of type Money carry kind: `fact` (computed straight from transcripts) or `estimate` (a what-if).",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "spend", "cache", "ttl", "tasks", "subagents", "deadContext", "setup", "switchSim", "actions"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedAt", "dir", "sessions", "files", "calls", "duplicateRowsDropped", "badLines", "unknownModelCalls", "days", "pricesAsOf", "plan", "lang"],
      "properties": {
        "generatedAt": { "type": "string", "description": "ISO 8601 timestamp" },
        "dir": { "type": "string", "description": "Transcripts directory that was read" },
        "since": { "type": "string", "description": "The --since value as given, e.g. 30d or 2026-09-01" },
        "sessions": { "type": "integer", "minimum": 0 },
        "files": { "type": "integer", "minimum": 0 },
        "calls": { "type": "integer", "minimum": 0, "description": "Deduplicated API requests" },
        "duplicateRowsDropped": { "type": "integer", "minimum": 0 },
        "badLines": { "type": "integer", "minimum": 0 },
        "unknownModelCalls": { "type": "integer", "minimum": 0 },
        "days": { "type": "integer", "minimum": 0, "description": "Length of the analysed period" },
        "pricesAsOf": { "type": "string", "description": "Date of the price table, YYYY-MM-DD" },
        "plan": { "enum": ["subscription", "api", "unknown"] },
        "lang": { "enum": ["ru", "en"] }
      }
    },
    "spend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "main", "subagents", "byFamily", "byProject", "byDay", "byWeek", "fastModeCost", "effortMix", "reconciliation"],
      "properties": {
        "total": { "$ref": "#/$defs/costBreakdown" },
        "main": { "$ref": "#/$defs/costBreakdown" },
        "subagents": { "$ref": "#/$defs/costBreakdown" },
        "byFamily": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "calls", "cost"],
            "properties": {
              "family": { "$ref": "#/$defs/modelFamily" },
              "calls": { "type": "integer", "minimum": 0 },
              "cost": { "$ref": "#/$defs/costBreakdown" }
            }
          }
        },
        "byProject": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project", "cost", "sessions"],
            "properties": {
              "project": { "type": "string" },
              "cost": { "type": "number" },
              "sessions": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "byDay": {
          "type": "array",
          "description": "Local-time days, ascending, gaps filled with 0",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "cost"],
            "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "cost": { "type": "number" } }
          }
        },
        "byWeek": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["weekStart", "cost"],
            "properties": { "weekStart": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "cost": { "type": "number" } }
          }
        },
        "fastModeCost": { "type": "number" },
        "effortMix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effort", "calls", "cost"],
            "properties": { "effort": { "type": "string" }, "calls": { "type": "integer", "minimum": 0 }, "cost": { "type": "number" } }
          }
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessionsChecked", "withinTolerance", "medianDeviation", "worstDeviation"],
          "description": "Our totals against Claude Code's own cost-state rows; sessions whose reported cost is under $0.05 are not compared",
          "properties": {
            "sessionsChecked": { "type": "integer", "minimum": 0 },
            "withinTolerance": { "type": "integer", "minimum": 0 },
            "medianDeviation": { "type": "number", "minimum": 0, "description": "Median absolute deviation, fraction, 0.02 = 2%" },
            "worstDeviation": { "type": "number", "minimum": 0, "description": "Fraction, 0.17 = 17%" }
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hitRatio", "rewriteCost", "losses"],
      "properties": {
        "hitRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "rewriteCost": { "type": "number", "description": "Spent on avoidable-looking cache rewrites (an estimate)" },
        "losses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cause", "events", "cost"],
            "properties": {
              "cause": { "enum": ["ttl", "model-switch", "compaction", "effort-change", "unknown"] },
              "events": { "type": "integer", "minimum": 0 },
              "cost": { "type": "number" }
            }
          }
        }
      }
    },
    "ttl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "gapHistogram", "recommendation"],
      "properties": {
        "observed": { "enum": ["5m", "1h", "mixed", "unknown"] },
        "gapHistogram": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "count"],
            "properties": { "label": { "type": "string" }, "count": { "type": "integer", "minimum": 0 } }
          }
        },
        "recommendation": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["ttl", "monthlySaving", "reason"],
              "properties": {
                "ttl": { "enum": ["5m", "1h"] },
                "monthlySaving": { "$ref": "#/$defs/money" },
                "reason": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "light", "lightOnExpensive", "maxEffortOnLight", "topExamples"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "light": { "type": "integer", "minimum": 0 },
        "lightOnExpensive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "cost", "asSonnet"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "cost": { "type": "number" },
            "asSonnet": { "type": "number", "description": "What the same tasks would cost on Sonnet (an upper-bound estimate)" }
          }
        },
        "maxEffortOnLight": { "type": "integer", "minimum": 0 },
        "topExamples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionId", "startTs", "endTs", "model", "mainCalls", "filesEdited", "outputTokens", "errors", "cost", "isLight", "firstPrompt"],
            "properties": {
              "sessionId": { "type": "string" },
              "startTs": { "type": "integer", "description": "epoch ms" },
              "endTs": { "type": "integer", "description": "epoch ms" },
              "model": { "type": "string", "description": "Dominant main-thread model id" },
              "effort": { "type": "string" },
              "mainCalls": { "type": "integer", "minimum": 0 },
              "filesEdited": { "type": "integer", "minimum": 0 },
              "outputTokens": { "type": "integer", "minimum": 0 },
              "errors": { "type": "integer", "minimum": 0 },
              "cost": { "type": "number" },
              "isLight": { "type": "boolean" },
              "firstPrompt": { "type": "string", "description": "Truncated to 200 characters" }
            }
          }
        }
      }
    },
    "subagents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["share", "calls", "cost", "byFamily", "byType", "haikuCandidates", "sonnetCandidates"],
      "properties": {
        "share": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fraction of total spend" },
        "calls": { "type": "integer", "minimum": 0 },
        "cost": { "type": "number" },
        "byFamily": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "cost"],
            "properties": { "family": { "$ref": "#/$defs/modelFamily" }, "cost": { "type": "number" } }
          }
        },
        "byType": {
          "type": "array",
          "description": "By agentType from the agent-<id>.meta.json files ('unknown' when there is none), most expensive first",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "calls", "cost"],
            "properties": { "type": { "type": "string" }, "calls": { "type": "integer", "minimum": 0 }, "cost": { "type": "number" } }
          }
        },
        "haikuCandidates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "cost", "asHaiku"],
          "description": "Explore (or read-only) subagent runs that used a model above haiku",
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "cost": { "type": "number" },
            "asHaiku": { "type": "number", "description": "Estimate" }
          }
        },
        "sonnetCandidates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "cost", "asSonnet"],
          "description": "general-purpose subagent runs on opus/fable (not already counted as haiku candidates)",
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "cost": { "type": "number" },
            "asSonnet": { "type": "number", "description": "What the same runs would cost on Sonnet (an upper-bound estimate)" }
          }
        }
      }
    },
    "deadContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "cost"],
      "properties": {
        "events": { "type": "integer", "minimum": 0 },
        "cost": { "type": "number", "description": "Spent re-reading old context after a probable topic change: an upper bound on what starting with /clear after each change would save (an estimate)" }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["avgFixedPrefixTokens", "fixedPrefixCost", "claudeMd"],
      "properties": {
        "avgFixedPrefixTokens": { "type": "number", "minimum": 0 },
        "fixedPrefixCost": { "type": "number", "description": "Cost of the session-start prefix over the whole period" },
        "claudeMd": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "tokens", "monthlyReadCost", "trimSaving"],
            "properties": {
              "path": { "type": "string" },
              "bytes": { "type": "integer", "minimum": 0 },
              "tokens": { "type": "number", "minimum": 0, "description": "About bytes / 3.6" },
              "monthlyReadCost": { "type": "number", "minimum": 0, "description": "Cache reads of this file by sessions started in its directory, scaled to 30 days (an estimate)" },
              "trimSaving": { "type": "number", "minimum": 0, "description": "The same for the part above 20 KB, per 30 days (an estimate)" }
            }
          }
        }
      }
    },
    "switchSim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "prefixTokens", "penalty", "savingPerStep", "breakEvenSteps"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "prefixTokens": { "type": "number", "minimum": 0 },
              "penalty": { "type": "number", "description": "One-off cache rewrite cost of the switch" },
              "savingPerStep": { "type": "number", "description": "Negative when the target model is not cheaper" },
              "breakEvenSteps": { "type": ["integer", "null"], "description": "null = never pays back" }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "Sorted by monthly.usd descending, top 3-5",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "detail", "monthly"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "monthly": { "$ref": "#/$defs/money" }
        }
      }
    }
  },
  "$defs": {
    "costBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "cacheWrite", "cacheRead", "output", "total"],
      "properties": {
        "input": { "type": "number" },
        "cacheWrite": { "type": "number" },
        "cacheRead": { "type": "number" },
        "output": { "type": "number" },
        "total": { "type": "number" }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usd", "kind"],
      "properties": { "usd": { "type": "number" }, "kind": { "enum": ["fact", "estimate"] } }
    },
    "modelFamily": {
      "enum": ["fable-5.1", "fable-5", "opus-5.5", "opus-5", "opus-4.x", "sonnet-5.5", "sonnet-5", "sonnet-4.x", "haiku-4.5", "unknown"]
    }
  }
}
